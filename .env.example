# MongoDB Docker credentials — used by docker-compose.yml
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=changeme
MONGO_INITDB_DATABASE=expense_tracker

# MongoDB connection URI — used by the Next.js application
# Format: mongodb://<user>:<password>@<host>:<port>/<database>?authSource=admin
MONGODB_URI=mongodb://admin:changeme@localhost:27017/expense_tracker?authSource=admin

# NextAuth — session signing secret
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# NextAuth — base URL (set to production domain on deployment)
NEXTAUTH_URL=http://localhost:3000
